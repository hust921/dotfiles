{
  "Boilerplate Python": {
    "prefix": [
      "boilerplate",
      "init",
      "argcheck"
    ],
    "body": [
      "#!/usr/bin/env python3",
      "import sys",
      "import logging",
      "",
      "LLFORMAT = \"[%(asctime)s][%(levelname)s]{%(filename)s:%(lineno)d}: %(message)s\"",
      "logging.basicConfig(stream=sys.stdout, level=logging.DEBUG, format=LLFORMAT)",
      "log = logging.getLogger()",
      "",
      "",
      "def main():",
      "    $0",
      "",
      "",
      "def argcheck():",
      "    if len(sys.argv) != 1:",
      "        print(f\"Usage: {sys.argv[0]}\")",
      "        exit(1)",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    argcheck()",
      "    main()"
    ],
    "description": "Python script boilerplate with argument check"
  }
}
